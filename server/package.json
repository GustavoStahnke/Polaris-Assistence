{
  "name": "@polaris/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts --production",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "backup": "tsx src/scripts/backup.ts"
  },
  "dependencies": {
    "@polaris/shared": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11"
  }
}
