# Configuração local do Polaris Assistence.
# O arquivo .env é criado automaticamente no primeiro start a partir deste modelo.

# Porta do servidor
PORT=3001

# Endereço em que o servidor escuta. 127.0.0.1 = só este computador.
# Para acessar pelo celular, ative o "modo rede local" em Configurações (não mude aqui).
HOST=127.0.0.1

# Chave de criptografia das credenciais e tokens.
# É gerada automaticamente no primeiro start. NUNCA compartilhe nem apague:
# sem ela, as credenciais salvas não podem ser lidas.
POLARIS_SECRET=
